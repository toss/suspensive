{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignore": ["**/test-utils/**"],
  "workspaces": {
    ".": {
      "ignore": ["packlint.config.mjs"],
      "ignoreDependencies": [
        "@cspell/eslint-plugin",
        "eslint-plugin-jest-dom",
        "eslint-plugin-jsdoc",
        "eslint-plugin-react-dom",
        "eslint-plugin-react-hooks-extra",
        "eslint-plugin-react-naming-convention",
        "eslint-plugin-react-web-api",
        "eslint-plugin-react-x"
      ]
    },
    "docs/suspensive.org": {
      "ignoreDependencies": ["sharp", "postcss", "server-only"],
      "entry": ["src/**/*.{ts,tsx,mdx}"]
    },
    "packages/react-dom": {
      "ignoreDependencies": ["react-dom", "@types/react-dom"],
      "ignore": ["**/utils/observe.ts"]
    },
    "packages/codemods": {
      "entry": ["src/bin/codemods.ts", "src/transforms/*.ts"],
      "ignore": ["**/testfixtures/**"]
    },
    "packages/next": {
      "entry": ["src/index.ts", "src/react-server.ts"]
    },
    "packages/react-query": {
      "entry": ["src/index.ts", "src/bin/cli.ts", "src/v4.ts", "src/v5.ts"]
    },
    "examples/next-streaming-react-query": {
      "ignoreDependencies": ["postcss"]
    },
    "examples/visualization": {
      "ignoreDependencies": ["postcss"]
    }
  }
}
